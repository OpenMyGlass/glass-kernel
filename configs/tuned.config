# OpenMyGlass "tuned" variant: build-only changes on top of notle_defconfig.
# Each line is checked in the final .config; the build fails if Kconfig drops one.
# Deadline instead of CFQ as the default I/O scheduler (eMMC, no rotational seeks).
# CONFIG_DEFAULT_CFQ is not set
CONFIG_DEFAULT_DEADLINE=y
CONFIG_DEFAULT_IOSCHED="deadline"
# Debug-only bookkeeping. PM_DEBUG stays: OMAP's off-mode switches live under it.
# CONFIG_THERMAL_FRAMEWORK_DEBUG is not set
# CONFIG_CPU_FREQ_STAT_DETAILS is not set
# Debugging and tracing with a runtime cost. FTRACE, TRACEPOINTS and DEBUG_FS stay for atrace/systrace.
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_RT_MUTEXES is not set
# CONFIG_DEBUG_PI_LIST is not set
# CONFIG_IRQSOFF_TRACER is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set
# CONFIG_FUNCTION_PROFILER is not set
# PERSISTENT_TRACER (Android, debug-only, no device registered on notle) selects FUNCTION_TRACER.
# CONFIG_PERSISTENT_TRACER is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_TIMER_STATS is not set
# CONFIG_KPROBES is not set
# CONFIG_OPROFILE is not set
