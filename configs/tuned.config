# OpenMyGlass "tuned" variant: build-only changes on top of notle_defconfig.
# Each line is checked in the final .config; the build fails if Kconfig drops one.
# Deadline instead of CFQ as the default I/O scheduler (eMMC, no rotational seeks).
# CONFIG_DEFAULT_CFQ is not set
CONFIG_DEFAULT_DEADLINE=y
CONFIG_DEFAULT_IOSCHED="deadline"
# Debug-only bookkeeping. PM_DEBUG stays: OMAP's off-mode switches live under it.
# CONFIG_THERMAL_FRAMEWORK_DEBUG is not set
# CONFIG_CPU_FREQ_STAT_DETAILS is not set
