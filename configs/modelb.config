# OpenMyGlass "modelb" variant: a plain-Linux (Alpine/musl) base on top of the
# tuned-stable 3.4.113 kernel. Each line is re-checked in the final .config; the
# build fails if Kconfig drops one (same mechanism as configs/tuned.config).
#
# Scope: this overlay changes only /dev and console plumbing. It never touches the
# DSS, panel-notle, FPGA-firmware-download or SmartReflex options, which stay
# exactly as the hardware-proven tuned-stable build (notle_defconfig) has them, so
# it cannot regress the display / firmware bring-up. See docs/model-b-energy.md.
#
# NOTE: added here because the repo had no modelb variant yet (the "plain-Linux
# config" backlog item). Kept deliberately conservative.

# --- /dev without an mdev dance ---
# devtmpfs is mounted by the kernel itself, so a lean musl init does not need the
# "tmpfs on /dev + mdev -s" workaround the Android-oriented config forced.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- A console on the Glass display (fbcon) ---
# In addition to the serial console on ttyO2 (CONFIG_SERIAL_OMAP_CONSOLE, already
# on), give the plain-Linux userspace a text console on the panel. fbcon attaches
# to the framebuffer that omapfb already creates (/dev/fb0); it does not change how
# the DSS, panel-notle-dpi or the iCE40 FPGA are brought up. CONFIG_VT is a
# dependency of CONFIG_FRAMEBUFFER_CONSOLE.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- Keep the sysfs early-suspend interface, not the VT-switching one ---
# Enabling VT makes the "User-space screen access" choice default to
# CONSOLE_EARLYSUSPEND (which switches VTs on blank). Model B does not want that:
# glassd blanks the panel directly with FBIOBLANK. Pin the sysfs variant
# (/sys/power/wait_for_fb_sleep, /sys/power/wait_for_fb_wake), which is also what
# notle_defconfig already selected before VT existed.
CONFIG_FB_EARLYSUSPEND=y
