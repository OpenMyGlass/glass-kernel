# OpenMyGlass "modelb-camera" variant: the camera-capture overlay for the
# plain-Linux Model B, layered on configs/modelb.config. Each line is re-checked
# in the final .config; the build fails if Kconfig drops one (same mechanism as
# configs/tuned.config and configs/modelb-power.config).
#
# READ THIS FIRST -- what this overlay does and does NOT do.
#
# The Google Glass (notle / OMAP4430) onboard camera has NO native Linux V4L2
# capture driver in this 3.4 tree. The OMAP4 ISS (ISP + CSI-2) and the camera
# sensor's I2C are NOT owned by Linux: the board file (arch/arm/mach-omap2/
# board-notle.c) registers NO camera v4l2 subdev and NO sensor on any I2C bus --
# it only wires the sensor's power rail (vaux2 "cam2pwr", 2.8 V) and the
# CAMERA_PWDN GPIO. drivers/media has NO omap4iss driver (only omap3isp, which is
# a different SoC, and omap_vout, which is display *output*, not capture).
#
# Capture is done by firmware running on the Ducati IPU (the dual Cortex-M3),
# which owns the ISS and drives the sensor. Linux reaches it over remoteproc +
# rpmsg: the camera "HAL" is a userspace OMX-IL client talking to the IPU through
# /dev/rpmsg-omx* (RPMSG_OMX) and /dev/rpmsg-rpc (RPC_OMAP), with ION/TILER
# buffers. There is therefore NO /dev/video* and NO /dev/media* for the onboard
# camera. (The V4L2 nodes notle_defconfig can create are only for a USB UVC
# webcam -- CONFIG_USB_VIDEO_CLASS -- not the built-in camera.)
#
# So this overlay CANNOT "turn on V4L2 capture" for the Glass camera: the driver
# that would create /dev/video does not exist in-tree. See docs/model-b-camera.md
# for the full topology, the two realistic paths to a working camera (reuse the
# Ducati/OMX path from musl, or backport the mainline omap4iss V4L2 driver +
# a sensor subdev), and why the native path belongs in OpenMyGlass/glass-mainline.
#
# What this overlay actually does, honestly:
#   (A) PINS the real capture path on, so the lean Model B kernel keeps it. These
#       are all already =y in notle_defconfig but are EXPERIMENTAL options a lean
#       "strip the Android cruft" pass could plausibly drop; they are load-bearing
#       for the camera, so we guard them (same regolation-guard pattern as
#       configs/modelb-power.config pinning the already-on power stack).
#   (B) Enables CONFIG_MEDIA_CONTROLLER as forward scaffolding for a future native
#       omap4iss backport. It is INERT on its own -- nothing binds to it until the
#       ISS + sensor drivers are added -- and creates no device node by itself.
#
# Scope/safety: this overlay changes no DSS, panel-notle, FPGA, backlight or power
# option. It cannot regress the modelb display/firmware bring-up.

# --- V4L2 core (already on; pin so the lean config keeps it) ---
# The Video4Linux2 core. Today it backs only the USB UVC path; it is also the
# prerequisite for any future native capture driver (omap4iss). VIDEOBUF2_* is
# deliberately NOT pinned here: those symbols have no Kconfig prompt (they are
# select-only) and would be dropped by oldconfig if nothing selects them. A
# backported omap4iss will "select VIDEOBUF2_DMA_CONTIG" and pull them in itself.
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2_COMMON=y

# --- Media Controller API (newly enabled scaffold) ---
# The media-controller framework a native omap4iss pipeline needs to expose its
# sensor -> CSI-2 -> ISS -> /dev/video topology and to let media-ctl link it.
# INERT until the ISS/sensor drivers exist: it creates no /dev/media on its own.
# (bool, depends on EXPERIMENTAL, which notle_defconfig has on.)
CONFIG_MEDIA_CONTROLLER=y

# --- Ducati IPU remoteproc: the processor that actually owns the camera ---
# Loads ducati-m3-core0.xem3 onto the dual Cortex-M3 and keeps it alive; the ISS
# firmware runs here. Without these there is no camera at all on this kernel.
CONFIG_REMOTEPROC=y
CONFIG_REMOTEPROC_USE_CARVEOUT=y
CONFIG_OMAP_REMOTEPROC=y
CONFIG_OMAP_REMOTEPROC_IPU=y
CONFIG_OMAP_REMOTEPROC_WATCHDOG=y

# --- IOMMU: the IPU's MMU, mapping its carveout + buffers ---
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_API=y
CONFIG_OMAP_IOMMU=y

# --- rpmsg transport + the OMX / RPC user-space channels ---
# virtio rpmsg bus (RPMSG), the resource manager the IPU uses to ask Linux to
# switch the camera regulator/clocks/GPIO on (RPMSG_RESMGR / OMAP_RPMSG_RESMGR),
# and the two user-facing channels the camera HAL uses:
#   RPMSG_OMX -> /dev/rpmsg-omx0 (ipu_c0), -omx1 (ipu_c1), -omx2 (dsp): OMX IL.
#   RPC_OMAP  -> /dev/rpmsg-rpc: the OMAP remote-procedure-call channel.
CONFIG_RPMSG=y
CONFIG_RPMSG_RESMGR_FWK=y
CONFIG_RPMSG_RESMGR=y
CONFIG_OMAP_RPMSG_RESMGR=y
CONFIG_RPMSG_OMX=y
CONFIG_RPC_OMAP=y

# --- Shared-buffer allocators the OMX camera frames travel through ---
# ION + the OMAP ION heaps, the DMM/TILER (2D tiled camera/video buffers), CMA and
# dma-buf. The IPU carveout size (CONFIG_OMAP4_IPU_CMA_SIZE=0x6b00000, ~107 MiB)
# is left at the notle_defconfig value and is NOT pinned here (it is a hex value,
# not a boolean); docs/model-b-camera.md notes it must stay large enough for the
# camera/video firmware.
CONFIG_ION=y
CONFIG_ION_OMAP=y
CONFIG_DRM_OMAP_DMM_TILER=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_CMA=y
