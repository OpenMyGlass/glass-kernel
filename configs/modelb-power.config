# OpenMyGlass "modelb-power" variant: the energy-policy overlay for the plain-Linux
# Model B, layered on configs/modelb.config. Power only; it touches no display,
# DSS, panel or FPGA option, so it cannot regress the modelb display/firmware
# bring-up. Each line is re-checked in the final .config; the build fails if
# Kconfig drops one.
#
# Most of the OMAP4 power stack is ALREADY compiled into notle_defconfig. The large
# battery wins on Model B are userspace POLICY (opportunistic suspend, radio off,
# dimming) driven by glassd -- see docs/model-b-energy.md for the sysfs hooks. This
# overlay's job is to (a) pin that stack on so no future "select" silently drops it,
# and (b) turn on the few idle-power options that were off.

# --- CPU idle: MPU C-states incl. retention / OFF ---
# OMAP4 cpuidle (cpuidle44xx) with the menu governor and the coupled-C-state code
# for the two Cortex-A9s; CPU_PM carries the idle/suspend notifier chain that lets
# the MPU power domain reach CSWR/OSWR/OFF. Off-mode itself is armed at runtime
# (debugfs: /sys/kernel/debug/pm_debug/enable_off_mode), which needs PM_DEBUG --
# kept on by configs/tuned.config.
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_CPU_PM=y

# --- Tickless idle ---
# No periodic tick while idle, high-resolution timers, and let RCU avoid waking an
# idle CPU just to run callbacks so it stays in a deep C-state longer.
# CONFIG_RCU_FAST_NO_HZ was off in notle_defconfig; this is the one behavioural add.
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_RCU_FAST_NO_HZ=y

# --- Suspend-to-RAM, wakelock-gated ---
# This Google 3.4 tree predates mainline PM_AUTOSLEEP/PM_WAKELOCKS; opportunistic
# suspend here is the Android path: userspace writes "mem" to /sys/power/state and
# the suspend is deferred until no wake lock is held. glassd holds a lock through
# /sys/power/wake_lock while it has work and releases it on screen-off.
CONFIG_SUSPEND=y
CONFIG_SUSPEND_FREEZER=y
CONFIG_PM_SLEEP=y
CONFIG_WAKELOCK=y
CONFIG_USER_WAKELOCK=y
CONFIG_EARLYSUSPEND=y

# --- Runtime PM for peripherals (USB / MMC / I2C / sensors autosuspend) ---
CONFIG_PM_RUNTIME=y
CONFIG_USB_SUSPEND=y
CONFIG_MMC_UNSAFE_RESUME=y

# --- SmartReflex / AVS: per-chip auto-undervolt stays on ---
# No manual voltage/frequency change (project safety rule); AVS does the per-chip
# undervolt that the tuned variants already rely on.
CONFIG_POWER_AVS=y
CONFIG_POWER_AVS_OMAP=y
CONFIG_POWER_AVS_OMAP_CLASS1_P5=y
CONFIG_POWER_AVS_OMAP_CLASS3=y

# --- cpufreq: interactive default, power-leaning govs available ---
# The chip is ~89% resident at 300 MHz, so the default is a low floor with a
# conservative ramp. glassd selects the eco/cool profile at boot via
# tuning/omg-tune.sh; keep the conservative and powersave governors compiled so it
# can fall back to them.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_INTERACTIVE=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y

# --- Radios fully powered down, no leakage ---
# rfkill with its PM resume hook and the GPIO backend so WiFi (bcmdhd) and BT can be
# hard-blocked by glassd; CFG80211 power-save on by default. Model B keeps WiFi OFF
# by default and uses BT as the main link.
CONFIG_RFKILL=y
CONFIG_RFKILL_PM=y
CONFIG_RFKILL_GPIO=y
CONFIG_CFG80211_DEFAULT_PS=y

# --- Thermal duty-cycle governor kept (safety; thresholds unchanged) ---
CONFIG_OMAP4_DUTY_CYCLE=y
CONFIG_OMAP4_DUTY_CYCLE_GOVERNOR=y
